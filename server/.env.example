# ============================================================
# 星梦小筑 后端环境变量示例
# 复制为 server/.env 后按需修改；不改也能跑（全部有默认值）
# 注意：server/.env 已在 .gitignore 中，不要提交到仓库
# ============================================================

# ---------- 服务 ----------
PORT=3000
NODE_ENV=production
# 启动成功后自动打开浏览器：1 开启（默认），0 关闭
# 部署在服务器 / Docker / 远程机器上建议设 0，否则会尝试打开（失败也不影响运行）
# AUTO_OPEN=0
# 允许跨域的来源，多个用逗号分隔；* 表示不限制
# CORS_ORIGIN=https://your-domain.com

# ---------- 管理员初始化 ----------
# 首次启动时数据库里没有管理员才会生效，之后改这里无效（请到后台"账号安全"改密码）
# 不填则自动生成随机密码，并在启动日志中打印一次
ADMIN_INIT_USERNAME=admin
# ADMIN_INIT_PASSWORD=请改成你自己的强密码

# 登录 token 有效期（小时），默认 12
ADMIN_TOKEN_TTL_HOURS=12

# ---------- 数据与文件 ----------
# SQLite 数据目录（默认 server/data）
# DATA_DIR=./data
# 也可以直接指定数据库文件路径
# DB_PATH=./data/look.db
# 上传文件目录（默认项目根目录的 uploads）
# UPLOAD_DIR=../uploads

# 前端 H5 构建产物目录（默认自动探测 unpackage/dist/build/h5）
# H5_DIST_DIR=../unpackage/dist/build/h5

# ---------- 音乐 ----------
# 每日推荐歌单的兜底值（后台"音乐配置"里改更灵活，优先级更高）
# MUSIC_RECOMMEND_PLAYLIST=3778678
